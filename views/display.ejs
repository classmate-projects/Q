<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Now Serving</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="display-body">
  <header class="display-header">
    <h1>Now Serving</h1>
    <div class="display-header-right">
      <button type="button" id="sound-toggle" class="sound-toggle off">🔔 Enable sound</button>
      <span id="clock" class="clock"></span>
    </div>
  </header>
  <main id="board" class="board">
    <% if (services.length === 0) { %>
      <p class="empty">No services available.</p>
    <% } else { %>
      <% services.forEach(function (service) { %>
        <section class="board-card" data-id="<%= service.id %>" style="--svc: var(--cat-<%= service.colorIndex %>)">
          <h2 class="board-name"><%= service.name %></h2>
          <div class="board-desks">
            <% service.desks.forEach(function (desk) { %>
              <div class="board-desk" data-desk="<%= desk.number %>">
                <span class="desk-token svc-ink"><%= desk.current || '—' %></span>
                <span class="desk-name">Desk <%= desk.number %></span>
              </div>
            <% }) %>
          </div>
        </section>
      <% }) %>
    <% } %>
  </main>
  <script src="/js/display.js"></script>
</body>
</html>
