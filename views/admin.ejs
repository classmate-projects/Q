<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin · YourQ</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a href="/" class="home-link">← Home</a>
  <header class="page-header">
    <h1>Admin</h1>
  </header>

  <section id="admin-section" class="panel">
    <div id="sub-banner" class="sub-banner hidden"></div>
    <div class="admin-grid">
      <div class="admin-card">
        <h2>Services</h2>
        <form id="add-service-form" class="add-service-form">
          <input type="text" id="new-service-name" placeholder="New service name" required>
          <label class="desk-count-field">Desks
            <input type="number" id="new-service-desks" min="1" max="20" value="1">
          </label>
          <button type="submit">Add</button>
        </form>
        <ul id="service-list" class="service-list"></ul>
      </div>

      <div class="admin-card">
        <h2>Daily Report</h2>
        <form id="report-form" class="inline-form">
          <input type="date" id="report-date">
          <button type="submit">Download CSV</button>
        </form>
      </div>
    </div>
    <button type="button" id="logout-btn" class="link-btn">Log out</button>
    <div class="admin-contact">
      <span class="admin-contact-label">Need help? Contact</span>
      <a href="mailto:classmate20240425@gmail.com">✉️ classmate20240425@gmail.com</a>
      <a href="https://wa.me/971566608834" target="_blank" rel="noopener">💬 WhatsApp +971 56 660 8834</a>
    </div>
  </section>

  <script src="/js/admin.js"></script>
</body>
</html>
